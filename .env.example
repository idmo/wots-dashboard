# Database (see docker-compose.yml for local dev; swap for a managed
# Postgres connection string — e.g. Neon or Supabase — when hosting on Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wots_orders"

# --- Ingram Book Company (PRD 3.2) ---
# Not required for this stub — INGRAM_MOCK=true uses realistic fake data
# from src/lib/services/ingram.ts. Set INGRAM_MOCK=false and fill these in
# once real Ingram API access is available.
INGRAM_MOCK=true
INGRAM_API_KEY=
INGRAM_CLIENT_SECRET=
INGRAM_ACCOUNT_NUMBER=

# --- Basil POS (PRD 7.3-7.4) ---
# Not required for this stub — BASIL_MOCK=true uses a generated sample
# export/import. Set to false once you're exchanging real Basil CSV files.
BASIL_MOCK=true

# --- OpenLibrary (PRD 3.2) ---
# No API key needed — openlibrary.org is a free, keyless API and is wired
# up live in src/lib/services/openlibrary.ts.
