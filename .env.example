# Database (see docker-compose.yml for local dev; swap for a managed
# Postgres connection string — e.g. Neon or Supabase — when hosting on Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wots_orders"

# --- Ingram Book Company (PRD 3.2) ---
# Not required for this stub — INGRAM_MOCK=true uses realistic fake data
# from src/lib/services/ingram.ts. Set INGRAM_MOCK=false and fill these in
# once real Ingram API access is available.
INGRAM_MOCK=true
INGRAM_API_KEY=
INGRAM_CLIENT_SECRET=
INGRAM_ACCOUNT_NUMBER=

# --- Basil POS (PRD 7.3-7.4) ---
# Not required for this stub — BASIL_MOCK=true uses a generated sample
# export/import. Set to false once you're exchanging real Basil CSV files.
BASIL_MOCK=true

# --- OpenLibrary (PRD 3.2) ---
# No API key needed — openlibrary.org is a free, keyless API and is wired
# up live in src/lib/services/openlibrary.ts.

# --- Authentication ---
# Only staff with an email on this domain can be added as a user (see
# src/app/api/users/route.ts).
ALLOWED_EMAIL_DOMAIN=wordonthestreetbooks.com

# Bootstraps the very first superadmin account on server startup (see
# src/instrumentation.ts) — only used if no user with this email exists
# yet. Safe to leave set permanently; it's a no-op after the first boot.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Marks the session cookie Secure (HTTPS-only). Keep "false" while this is
# only reachable over plain http:// (e.g. a bare VPS IP) — a Secure cookie
# is silently dropped by the browser over http, and login will look broken
# rather than actually erroring. Set to "true" once a domain + HTTPS
# reverse proxy is in front of this (see README "Hosting").
COOKIE_SECURE=false

# --- Email (Brevo) — new-account and password-reset emails ---
# Not required for this stub — EMAIL_MOCK=true logs emails to the server
# console instead of sending them (the Users admin page also shows the
# generated password directly in that case, since no real email went out).
# Set EMAIL_MOCK=false and fill these in to send real email through Brevo
# (already part of the store's stack) — see src/lib/services/email.ts.
EMAIL_MOCK=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Word on the Street Books
